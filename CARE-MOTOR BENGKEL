    def validasi_input_kendaraan(self, fields):
        """Validasi input profil kendaraan.
        Mengembalikan (nopol, merk, tipe, tahun, km) atau None jika tidak valid."""
        nopol = normalisasi_nopol(fields["Nomor Polisi"].get())
        merk = fields["Merk"].get().strip()
        tipe = fields["Tipe"].get().strip()
        if not nopol or not merk or not tipe:
            tampil_error("Nomor polisi, merk, dan tipe wajib diisi")
            return None
        try:
            tahun = parse_angka(fields["Tahun"].get())
        except ValueError:
            tampil_error("Tahun kendaraan harus berupa angka")
            return None
        if tahun < 1900 or tahun > date.today().year + 1:
            tampil_error("Tahun kendaraan tidak valid")
            return None
        try:
            km = parse_angka(fields["Kilometer Saat Ini"].get())
        except ValueError:
            tampil_error("Kilometer harus berupa angka bulat")
            return None
        if km < 0:
            tampil_error("Kilometer tidak boleh negatif")
            return None
        return nopol, merk, tipe, tahun, km

