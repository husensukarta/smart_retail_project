    def form_tambah_kendaraan(self, kembali_ke_data=False):
        """Member memasukkan data motor miliknya sendiri."""
        win = self.jendela_form("Input Data Motor Saya")
        fields = {}
        for label in ("Nomor Polisi", "Merk", "Tipe", "Tahun", "Kilometer Saat Ini"):
            fields[label] = self.buat_input(win, label)
        def simpan():
            hasil = self.validasi_input_kendaraan(fields)
            if hasil is None:
                return
            nopol, merk, tipe, tahun, km = hasil
            try:
                with koneksi() as conn:
                    sudah_ada = conn.execute(
                        "SELECT 1 FROM kendaraan WHERE user_id=? AND REPLACE(UPPER(nomor_polisi), ' ', '')=?",
                        (self.user["id"], nopol)
                    ).fetchone()
                    if sudah_ada:
                        tampil_error("Nomor polisi tersebut sudah terdaftar di akun Anda")
                        return
