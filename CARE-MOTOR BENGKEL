def koneksi():
    """Membuka koneksi database SQLite."""
    conn = sqlite3.connect(DB_NAME)
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def hash_password(password):
    """Mengubah password menjadi hash sebelum disimpan."""
    return hashlib.sha256(password.encode("utf-8")).hexdigest()


def buat_database():
    """Membuat tabel jika database belum tersedia."""
    with koneksi() as conn:
        conn.executescript("""
            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nama TEXT NOT NULL,
                username TEXT NOT NULL UNIQUE,
                password TEXT NOT NULL,
                role TEXT NOT NULL DEFAULT 'user'
            );

            CREATE TABLE IF NOT EXISTS kendaraan (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                nomor_polisi TEXT NOT NULL,
                merk TEXT NOT NULL,
                tipe TEXT NOT NULL,
                tahun INTEGER NOT NULL,
                kilometer_saat_ini INTEGER NOT NULL DEFAULT 0,
                FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE
            );

            CREATE TABLE IF NOT EXISTS riwayat_servis (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                id_kendaraan INTEGER NOT NULL,
                jenis_servis TEXT NOT NULL,
                km_saat_servis INTEGER NOT NULL,
                tanggal_servis TEXT NOT NULL,
                biaya INTEGER NOT NULL DEFAULT 0,
                km_target_berikutnya INTEGER NOT NULL,
                catatan TEXT,
                FOREIGN KEY(id_kendaraan) REFERENCES kendaraan(id) ON DELETE CASCADE
            );
        """)
        conn.executescript("""
            CREATE INDEX IF NOT EXISTS idx_kendaraan_user
                ON kendaraan(user_id);
            CREATE INDEX IF NOT EXISTS idx_riwayat_kendaraan
                ON riwayat_servis(id_kendaraan);
            CREATE INDEX IF NOT EXISTS idx_riwayat_tanggal
                ON riwayat_servis(tanggal_servis);
        """)
        # Migrasi database lama: tambahkan kolom role jika belum tersedia.
        kolom_user = {
            row[1] for row in conn.execute("PRAGMA table_info(users)").fetchall()
        }
        if "role" not in kolom_user:
            conn.execute(
                "ALTER TABLE users ADD COLUMN role TEXT NOT NULL DEFAULT 'user'"
            )

        # Akun admin awal dibuat hanya jika username admin belum tersedia.
        admin_ada = conn.execute(
            "SELECT id FROM users WHERE username = ?", ("admin",)
        ).fetchone()
        if not admin_ada:
            conn.execute(
                """INSERT INTO users(nama, username, password, role)
                   VALUES (?, ?, ?, ?)""",
                ("Administrator CARE-MOTOR", "admin",
                 hash_password("admin12345"), "admin")
            )


def rupiah(angka, spasi=True):
    """Format rupiah: 'Rp 1.250.000' (spasi=True) atau 'Rp1.250.000'."""
    awalan = "Rp " if spasi else "Rp"
    return awalan + f"{int(angka):,}".replace(",", ".")


def format_angka(angka):
    """Format angka dengan titik ribuan: 15500 -> 15.500"""
    return f"{int(angka):,}".replace(",", ".")


def format_km(angka):
    """Format kilometer: 17500 -> 17.500 Km"""
    return format_angka(angka) + " Km"


def parse_angka(teks):
    """Mengubah input seperti '15.500' atau '75000' menjadi integer.
    Melempar ValueError jika bukan angka bulat."""
    bersih = teks.strip().lower().replace("rp", "")
    bersih = bersih.replace(".", "").replace(",", "").replace(" ", "")
    return int(bersih)


def parse_tanggal(teks):
    """Menerima DD-MM-YYYY atau YYYY-MM-DD, mengembalikan objek date."""
    teks = teks.strip()
    for pola in ("%d-%m-%Y", "%Y-%m-%d"):
        try:
            return datetime.strptime(teks, pola).date()
        except ValueError:
            continue
    raise ValueError("format tanggal tidak valid")


def format_tanggal(nilai):
    """Tanggal di database (YYYY-MM-DD) ditampilkan sebagai DD-MM-YYYY."""
    try:
        return datetime.strptime(nilai, "%Y-%m-%d").strftime("%d-%m-%Y")
    except (ValueError, TypeError):
        return nilai or "-"


def normalisasi_nopol(teks):
    """'b 1234 xyz' -> 'B1234XYZ'"""
    return teks.replace(" ", "").strip().upper()


def tampil_error(pesan):
    """Menampilkan pesan error dengan format:  ERROR: <pesan>"""
    messagebox.showerror("ERROR", f"ERROR:\n{pesan}")


def teks_status(status, sisa):
    """Teks notifikasi sesuai ketentuan (percabangan 3 kondisi)."""
    if status == "TERLAMBAT":
        return (f"BAHAYA !!!\n\nAnda terlambat servis\n\n"
                f"Keterlambatan:\n{format_km(abs(sisa))}")
    elif status == "MENDEKATI SERVIS":
        return (f"PERINGATAN\n\nServis akan jatuh tempo\n\n"
                f"Sisa:\n{format_km(sisa)} lagi")
    else:
        return f"STATUS:\n\nMasih Aman\n\nSisa:\n{format_km(sisa)} lagi"


