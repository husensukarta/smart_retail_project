    def jendela_laporan(self):
        data_motor = self.ambil_kendaraan()
        if not data_motor:
            messagebox.showinfo("Laporan", "Belum ada kendaraan.")
            return
        win = tk.Toplevel(self.root)
        win.title("Laporan Kendaraan")
        win.geometry("650x570")
        frame = tk.Frame(win, bg="white", padx=22, pady=18)
        frame.pack(fill="both", expand=True)
        tk.Label(frame, text="LAPORAN CARE-MOTOR", bg="white", fg=PRIMARY,
                 font=("Arial", 19, "bold")).pack(anchor="w", pady=(0, 12))
        tk.Label(frame, text="Pilih kendaraan", bg="white").pack(anchor="w")
        pilih = ttk.Combobox(frame, state="readonly",
            values=[f"{d[0]} | {d[1]} | {d[2]} {d[3]}" for d in data_motor])
        pilih.pack(fill="x", pady=7)
        pilih.current(0)
        area = tk.Text(frame, height=20, font=("Consolas", 10), wrap="word")
        area.pack(fill="both", expand=True, pady=8)
        hasil = {}  # menyimpan laporan terakhir yang ditampilkan, dipakai untuk simpan CSV

        def tampilkan():
            motor_id = int(pilih.get().split("|")[0].strip())
            motor = next(d for d in data_motor if d[0] == motor_id)
            records = [r for r in self.ambil_semua_riwayat() if r[1] == motor_id]
            total = sum(r[8] for r in records)
            jadwal = [n for n in self.hitung_notifikasi() if n["motor_id"] == motor_id]
            terdekat = min(jadwal, key=lambda x: x["sisa"], default=None)
            garis = "=" * 22
            baris = [
                garis, "", "CARE MOTOR REPORT", "", garis, "",
                "Motor:", f"{motor[2]} {motor[3]}", "",
                "KM Saat Ini:", format_angka(motor[5]), "",
                "Total Servis:", str(len(records)), "",
                "Total Biaya:", rupiah(total, spasi=False), "",
                "Servis Berikutnya:", terdekat["jenis"] if terdekat else "-", "",
                "Target:", format_km(terdekat["target"]) if terdekat else "-", "",
                garis,
            ]
            area.delete("1.0", "end")
            area.insert("end", "\n".join(baris) + "\n")
            hasil.clear()
            hasil.update(motor=motor, records=records, total=total, terdekat=terdekat)

        def simpan_csv():
            if not hasil:
                return
            motor, records = hasil["motor"], hasil["records"]
            total, terdekat = hasil["total"], hasil["terdekat"]
            nopol = str(motor[1]).replace(" ", "_")
            path = filedialog.asksaveasfilename(
                parent=win, defaultextension=".csv", filetypes=[("CSV", "*.csv")],
                initialfile=f"laporan_servis_{nopol}_{date.today():%Y%m%d}.csv"
            )
            if not path:
                return
            try:
                with open(path, "w", newline="", encoding="utf-8-sig") as file:
                    w = csv.writer(file)
                    w.writerow(["LAPORAN CARE-MOTOR"])
                    w.writerow(["Tanggal Cetak", date.today().strftime("%d-%m-%Y")])
                    w.writerow(["Nomor Polisi", motor[1]])
                    w.writerow(["Motor", f"{motor[2]} {motor[3]}"])
                    w.writerow(["KM Saat Ini", motor[5]])
                    w.writerow(["Total Servis", len(records)])
                    w.writerow(["Total Biaya", hasil["total"]])
                    w.writerow(["Servis Berikutnya", terdekat["jenis"] if terdekat else "-"])
                    w.writerow(["Target KM", terdekat["target"] if terdekat else "-"])
                    w.writerow([])
                    w.writerow(["RIWAYAT SERVIS"])
                    w.writerow(["Tanggal", "Jenis Servis", "KM Servis", "Biaya",
                                "Target Berikutnya", "Catatan"])
                    for r in records:
                        w.writerow([r[6], r[5], r[7], r[8], r[9], r[10] or ""])
                messagebox.showinfo("Berhasil", f"Laporan berhasil disimpan ke:\n{path}", parent=win)
            except OSError as error:
                messagebox.showerror("Gagal menyimpan", str(error), parent=win)

        tombol = tk.Frame(frame, bg="white")
        tombol.pack(anchor="e")
        self.buat_tombol(tombol, "SIMPAN KE CSV", simpan_csv, GREEN).pack(side="left", padx=(0, 8))
        self.buat_tombol(tombol, "BUAT LAPORAN", tampilkan).pack(side="left")
        tampilkan()

