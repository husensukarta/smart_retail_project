    def form_tambah_servis(self, kendaraan_id_awal=None):
        """Form servis motor: pilih jenis servis, harga terisi otomatis."""
        win = self.jendela_form("Servis Motor")
        tk.Label(win, text="Pilih kendaraan", bg="white").pack(anchor="w")
        pilihan, data = self.pilih_kendaraan(win)
        if pilihan is None:
            win.winfo_toplevel().destroy()
            return
        if kendaraan_id_awal is not None:
            for indeks, d in enumerate(data):
                if d[0] == kendaraan_id_awal:
                    pilihan.current(indeks)
        tk.Label(win, text="Jenis servis", bg="white").pack(anchor="w")
        jenis = ttk.Combobox(win, state="readonly", values=list(INTERVAL_SERVIS.keys()))
        jenis.pack(fill="x", pady=(3, 12))
        jenis.current(0)
        tanggal = self.buat_input(win, "Tanggal servis (DD-MM-YYYY)")
        tanggal.insert(0, date.today().strftime("%d-%m-%Y"))
        km = self.buat_input(win, "Kilometer saat servis")
        biaya = self.buat_input(win, "Biaya servis (otomatis dari daftar harga, bisa diubah)")

        def isi_harga(_event=None):
            biaya.delete(0, "end")
            biaya.insert(0, format_angka(HARGA_SERVIS.get(jenis.get(), 0)))
        jenis.bind("<<ComboboxSelected>>", isi_harga)
        isi_harga()
        catatan = self.buat_input(win, "Catatan (opsional)")
        def simpan():
            try:
                kendaraan_id = int(pilihan.get().split("|")[0].strip())
                kendaraan = next(d for d in data if d[0] == kendaraan_id)
            except (ValueError, StopIteration):
                tampil_error("Pilih kendaraan terlebih dahulu")
                return
            if jenis.get() not in INTERVAL_SERVIS:
                tampil_error("Jenis servis tidak valid")
                return
            try:
                tanggal_obj = parse_tanggal(tanggal.get())
            except ValueError:
                tampil_error("Format tanggal harus DD-MM-YYYY")
                return
            if tanggal_obj > date.today():
                tampil_error("Tanggal servis tidak boleh di masa depan")
                return
            try:
                km_servis = parse_angka(km.get())
            except ValueError:
                tampil_error("Kilometer servis harus berupa angka bulat")
                return
            if km_servis < 0:
                tampil_error("Kilometer tidak boleh negatif")
                return
            if km_servis > kendaraan[5]:
                tampil_error("KM servis tidak boleh melebihi kilometer kendaraan saat ini")
                return
            try:
                biaya_servis = parse_angka(biaya.get())
            except ValueError:
                tampil_error("Biaya servis harus berupa angka")
                return
            if biaya_servis < 0:
                tampil_error("Biaya servis tidak boleh negatif")
                return
            # Target servis berikutnya = KM saat servis + interval jenis servis
            interval = INTERVAL_SERVIS[jenis.get()]
            target = km_servis + interval
            with koneksi() as conn:
                conn.execute("""INSERT INTO riwayat_servis
                    (id_kendaraan, jenis_servis, km_saat_servis, tanggal_servis,
                     biaya, km_target_berikutnya, catatan)
                    VALUES (?, ?, ?, ?, ?, ?, ?)""",
                    (kendaraan_id, jenis.get(), km_servis, tanggal_obj.isoformat(),
                     biaya_servis, target, catatan.get().strip()))
            messagebox.showinfo("Berhasil", f"Servis berhasil dicatat.\n\nJenis Servis : {jenis.get()}\nBiaya        : {rupiah(biaya_servis)}\nInterval     : {format_km(interval)}\nTarget berikutnya: {format_km(target)}")
            win.winfo_toplevel().destroy()
            self.tampilkan_dashboard()
        self.buat_tombol(win, "SIMPAN RIWAYAT", simpan, GREEN).pack(fill="x", pady=10)

    def ambil_semua_riwayat(self):
        with koneksi() as conn:
            return conn.execute("""
                SELECT r.id, k.id, k.nomor_polisi, k.merk, k.tipe,
                       r.jenis_servis, r.tanggal_servis, r.km_saat_servis,
                       r.biaya, r.km_target_berikutnya, r.catatan,
                       k.kilometer_saat_ini
                FROM riwayat_servis r
                JOIN kendaraan k ON k.id=r.id_kendaraan
                WHERE k.user_id=?
                ORDER BY r.tanggal_servis DESC, r.id DESC
            """, (self.user["id"],)).fetchall()

    def hitung_notifikasi(self):
        # Jadwal dihitung dari catatan servis terakhir untuk setiap jenis servis.
        kendaraan = self.ambil_kendaraan()
        hasil = []
        riwayat = self.ambil_semua_riwayat()
        for motor in kendaraan:
            motor_id, nopol, merk, tipe, tahun, km_sekarang = motor
            terakhir = {}
            for row in riwayat:
                if row[1] == motor_id and row[5] not in terakhir:
                    terakhir[row[5]] = row
            for jenis, row in terakhir.items():
                target = row[9]
                sisa = target - km_sekarang
                if sisa < 0:
                    status = "TERLAMBAT"
                elif sisa < BATAS_PERINGATAN_KM:
                    status = "MENDEKATI SERVIS"
                else:
                    status = "MASIH AMAN"
                hasil.append({
                    "motor_id": motor_id, "nopol": nopol, "motor": f"{merk} {tipe}", "jenis": jenis,
                    "km": km_sekarang, "target": target, "sisa": sisa, "status": status
                })
        return hasil

